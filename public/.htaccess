Options -Indexes
RewriteEngine On
# Bloquer les fichiers cachés et les fichiers de configuration
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|phpunit\.xml)$">
 Require all denied
</FilesMatch>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
